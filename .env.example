# ============================================================
# SmartCart Microservices — Environment Variables
# ============================================================
# Copy this file to .env and fill in production values.
#   cp .env.example .env
# .env is listed in .gitignore — NEVER commit real secrets.
# ============================================================

# ── Database ─────────────────────────────────────────────────────────────────
# Shared password for all four PostgreSQL instances.
# Use a different password per DB in production.
PG_PASSWORD=sc_pass_2026

# ── JWT ──────────────────────────────────────────────────────────────────────
# Secret used by user-service (issue) and api-gateway (verify).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_long_random_string_in_production

# ── Internal Service Auth ────────────────────────────────────────────────────
# Shared secret between order-service (caller) and product-service (verifier).
# Protects internal-only endpoints such as PATCH /products/:id/stock.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_SECRET=CHANGE_ME_internal_secret

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
# Erlang inter-node cookie (any random string, keep consistent across nodes).
RABBITMQ_ERLANG_COOKIE=CHANGE_ME_erlang_cookie

# RabbitMQ management UI credentials (default: guest/guest, change in production).
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# AMQP connection URL used by order-service and payment-service.
# Format: amqp://<user>:<pass>@<host>:<port>
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Backend services (user/product/order/payment): include the gateway origin.
# API gateway: include the frontend origin.
CORS_ORIGINS=http://localhost:3000

# ── JWT Expiry ────────────────────────────────────────────────────────────────
# Token lifetime. Use short values in production (e.g. 15m) + refresh tokens.
JWT_EXPIRY=7d

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level for all services. Options: error, warn, info, debug
# Use 'debug' in development, 'info' or 'warn' in production.
LOG_LEVEL=info
