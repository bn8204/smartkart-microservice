graph LR
    subgraph Producer["order-service (Publisher)"]
        PUB["publishOrderPlaced()"]
    end
    
    subgraph Broker["RabbitMQ"]
        DLX["smartcart.dlx\nDead Letter Exchange"]
        Q1["order.placed\n(durable, DLX→smartcart.dlx)"]
        DLQ1["order.placed.dlq"]
        Q2["payment.processed\n(durable, DLX→smartcart.dlx)"]
        DLQ2["payment.processed.dlq"]
    end
    
    subgraph Consumer1["payment-service (Consumer)"]
        CON1["startConsumer()\nprefetch(1)"]
        PUB2["publishPaymentProcessed()"]
    end
    
    subgraph Consumer2["order-service (Consumer)"]
        CON2["startConsumer()\nprefetch(1)"]
    end
    
    PUB -->|publish persistent msg| Q1
    Q1 -->|deliver| CON1
    CON1 -->|ack on success| Q1
    CON1 -->|nack no-requeue on failure| DLX
    DLX -->|dead letter| DLQ1
    
    CON1 --> PUB2
    PUB2 -->|publish payment.processed| Q2
    Q2 -->|deliver| CON2
    CON2 -->|ack on success| Q2
    CON2 -->|nack on failure| DLX
    DLX -->|dead letter| DLQ2
